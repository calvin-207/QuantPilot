{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantpilot.dev/contracts/etf-snapshot-v1.schema.json",
  "title": "QuantPilot ETF 看板快照（schema: 1）",
  "description": "etf/ 子系统已发布快照的数据契约，Python 与 Node 共用。运行时权威校验器为 etf/scripts/lib/seed.mjs；本 schema 是跨语言的镜像契约，供 Python 契约测试与阶段1快照生成器使用。结构性跨字段规则（数组等长、分类合计对账、分钟累计对账、覆盖数关系）在 seed.mjs 中强制，schema 仅表达单字段形状。",
  "type": "object",
  "required": ["schema", "provider", "sources", "built_at", "formula", "flow_policy", "universe", "categories", "calendar", "history", "broad", "minutes", "minute_slots", "latest_flow_date"],
  "additionalProperties": true,
  "properties": {
    "schema": { "const": 1 },
    "provider": { "enum": ["Demo", "FTShare", "FTShare+PublicSources"], "description": "Demo 表示程序生成的合成数据；真实数据禁止标记为 Demo，合成数据禁止标记为真实来源。" },
    "sources": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "built_at": { "type": "string", "format": "date-time" },
    "formula": { "const": "exchange_aligned_shares_verified_events_v3", "description": "计算口径版本，必须与本发布版本的模型一致。" },
    "flow_policy": { "type": "string", "minLength": 1 },
    "demo": {
      "type": "object",
      "required": ["as_of", "notice"],
      "properties": {
        "as_of": { "$ref": "#/$defs/isoDate" },
        "notice": { "type": "string" },
        "fund_flows": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "type": "number" } } }
      }
    },
    "universe_policy": { "type": "object" },
    "universe": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "required": ["symbol", "name", "bucket", "is_core_basket", "inception_date", "listed_date"],
        "properties": {
          "symbol": { "type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ)$" },
          "name": { "type": "string", "minLength": 1 },
          "bucket": { "$ref": "#/$defs/category" },
          "is_core_basket": { "type": "boolean" },
          "inception_date": { "$ref": "#/$defs/isoDate" },
          "listed_date": { "$ref": "#/$defs/isoDate" },
          "tracking_index_name": { "type": "string" },
          "tracking_index_symbol": { "type": "string" }
        }
      }
    },
    "categories": { "$ref": "#/$defs/categories" },
    "colors": { "type": "array", "items": { "type": "string" } },
    "calendar": { "$ref": "#/$defs/dateArray", "description": "升序唯一交易日列表。" },
    "history": {
      "type": "object",
      "required": ["dates", "amount", "idx", "netflow", "flow_coverage", "flow_expected"],
      "properties": {
        "dates": { "$ref": "#/$defs/dateArray" },
        "amount": { "$ref": "#/$defs/numberArray" },
        "idx": { "$ref": "#/$defs/numberArray" },
        "netflow": { "$ref": "#/$defs/numberArray" },
        "flow_coverage": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "flow_expected": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
      }
    },
    "broad": {
      "type": "object",
      "required": ["dates", "cats", "total", "series", "coverage"],
      "properties": {
        "dates": { "$ref": "#/$defs/dateArray" },
        "cats": { "$ref": "#/$defs/categories" },
        "colors": { "type": "array", "items": { "type": "string" } },
        "total": { "$ref": "#/$defs/numberArray" },
        "series": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/category" },
          "required": ["沪深300", "中证1000", "中证500", "科创50", "中证A500", "创业板指", "上证50", "其他宽基", "创业板50", "双创50", "中证2000", "国证2000"],
          "additionalProperties": { "$ref": "#/$defs/numberArray" }
        },
        "coverage": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/category" },
          "required": ["沪深300", "中证1000", "中证500", "科创50", "中证A500", "创业板指", "上证50", "其他宽基", "创业板50", "双创50", "中证2000", "国证2000"],
          "additionalProperties": {
            "type": "object",
            "required": ["valid", "expected"],
            "properties": {
              "valid": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
              "expected": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
            }
          }
        },
        "issues": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["symbol", "name", "bucket", "reasons"],
              "properties": {
                "symbol": { "type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ)$" },
                "name": { "type": "string" },
                "bucket": { "$ref": "#/$defs/category" },
                "reasons": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "minutes": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/isoDate" },
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["bars", "cumulative"],
        "properties": {
          "bars": { "$ref": "#/$defs/numberArray", "minItems": 241, "maxItems": 241 },
          "cumulative": { "$ref": "#/$defs/numberArray", "minItems": 241, "maxItems": 241 }
        }
      }
    },
    "minute_slots": { "const": ["09:30","09:31","09:32","09:33","09:34","09:35","09:36","09:37","09:38","09:39","09:40","09:41","09:42","09:43","09:44","09:45","09:46","09:47","09:48","09:49","09:50","09:51","09:52","09:53","09:54","09:55","09:56","09:57","09:58","09:59","10:00","10:01","10:02","10:03","10:04","10:05","10:06","10:07","10:08","10:09","10:10","10:11","10:12","10:13","10:14","10:15","10:16","10:17","10:18","10:19","10:20","10:21","10:22","10:23","10:24","10:25","10:26","10:27","10:28","10:29","10:30","10:31","10:32","10:33","10:34","10:35","10:36","10:37","10:38","10:39","10:40","10:41","10:42","10:43","10:44","10:45","10:46","10:47","10:48","10:49","10:50","10:51","10:52","10:53","10:54","10:55","10:56","10:57","10:58","10:59","11:00","11:01","11:02","11:03","11:04","11:05","11:06","11:07","11:08","11:09","11:10","11:11","11:12","11:13","11:14","11:15","11:16","11:17","11:18","11:19","11:20","11:21","11:22","11:23","11:24","11:25","11:26","11:27","11:28","11:29","11:30","13:01","13:02","13:03","13:04","13:05","13:06","13:07","13:08","13:09","13:10","13:11","13:12","13:13","13:14","13:15","13:16","13:17","13:18","13:19","13:20","13:21","13:22","13:23","13:24","13:25","13:26","13:27","13:28","13:29","13:30","13:31","13:32","13:33","13:34","13:35","13:36","13:37","13:38","13:39","13:40","13:41","13:42","13:43","13:44","13:45","13:46","13:47","13:48","13:49","13:50","13:51","13:52","13:53","13:54","13:55","13:56","13:57","13:58","13:59","14:00","14:01","14:02","14:03","14:04","14:05","14:06","14:07","14:08","14:09","14:10","14:11","14:12","14:13","14:14","14:15","14:16","14:17","14:18","14:19","14:20","14:21","14:22","14:23","14:24","14:25","14:26","14:27","14:28","14:29","14:30","14:31","14:32","14:33","14:34","14:35","14:36","14:37","14:38","14:39","14:40","14:41","14:42","14:43","14:44","14:45","14:46","14:47","14:48","14:49","14:50","14:51","14:52","14:53","14:54","14:55","14:56","14:57","14:58","14:59","15:00"], "description": "常规交易日分钟槽位：上午 09:30–11:30、下午 13:01–15:00，共 241 个。跨语言固定常量。" },
    "latest_flow_date": { "$ref": "#/$defs/isoDate", "description": "必须属于 broad.dates（跨字段规则，由 seed.mjs 强制）。" },
    "latest_market_date": { "$ref": "#/$defs/isoDate" },
    "source_audit": { "type": "object" },
    "core_fund_daily": {
      "type": "object",
      "required": ["date", "captured_at", "rows"],
      "description": "可选：雷达日度信号。正式发布要求20只核心ETF记录齐全且合计与 history.netflow 对应日期一致。",
      "properties": {
        "date": { "$ref": "#/$defs/isoDate" },
        "captured_at": { "type": "string", "format": "date-time" },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["symbol", "flow"],
            "properties": {
              "symbol": { "type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ)$" },
              "flow": { "type": ["number", "null"], "description": "单位：亿元。" }
            }
          }
        }
      }
    },
    "live_snapshot": { "type": "object", "description": "可选：上次成功实时行情，形状见 contracts/etf-api-v1.md 的 /api/live 响应（不含 cache 字段）。" },
    "cloud_update": { "type": ["object", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "provider": { "const": "Demo" } }, "required": ["provider"] },
      "then": { "required": ["demo"] }
    },
    {
      "if": { "properties": { "provider": { "not": { "const": "Demo" } } }, "required": ["provider"] },
      "then": { "properties": { "demo": false } }
    }
  ],
  "$defs": {
    "isoDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "dateArray": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/isoDate" } },
    "numberArray": { "type": "array", "items": { "type": ["number", "null"] } },
    "category": { "enum": ["沪深300", "中证1000", "中证500", "科创50", "中证A500", "创业板指", "上证50", "其他宽基", "创业板50", "双创50", "中证2000", "国证2000"] },
    "categories": { "const": ["沪深300", "中证1000", "中证500", "科创50", "中证A500", "创业板指", "上证50", "其他宽基", "创业板50", "双创50", "中证2000", "国证2000"] }
  }
}
